# ──────────────────────────────────────────────────
# Link2 Backend — Environment Variables
# Copy this file to .env and fill in real values
# ──────────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# JWT (Phase 3 — not used yet)
JWT_SECRET=
JWT_EXPIRES_IN=7d
